# Copie para .env e preencha os valores. NÃO commite o .env (já está no .gitignore).

# Site
NEXT_PUBLIC_SITE_URL=https://koraintelligence.com.br

# Leads: URL do App da Web do Apps Script (scripts/lead-webhook.gs)
LEAD_WEBHOOK_URL=
# Mesmo valor da propriedade LEAD_WEBHOOK_SECRET do Apps Script
LEAD_WEBHOOK_SECRET=

# WhatsApp
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_WHATSAPP_MESSAGE=

# Tracking
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=

# Sentry (observabilidade — error tracking)
# DSN público do projeto. Vazio = Sentry desativado (no-op), app roda normal.
# Pegue em: Sentry > Settings > Projects > [projeto] > Client Keys (DSN).
NEXT_PUBLIC_SENTRY_DSN=
# As variáveis abaixo são só para upload de sourcemaps no build (CI/Vercel).
# Configure-as como env vars na Vercel, não no .env local.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# PostHog (observabilidade — funil de conversão)
# Vazio = PostHog desativado (no-op). Project API Key em: PostHog > Settings > Project.
# Host: us.i.posthog.com (EUA) ou eu.i.posthog.com (UE).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
